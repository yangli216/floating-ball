              },
              {
                "key": "familyHistory",
                "label": "家族病史",
                "type": "input",
                "props": {
                  "placeholder": "请描述家族重要疾病"
                }
              },
              {
                "key": "currentMedication",
                "label": "目前用药",
                "type": "input",
                "props": {
                  "placeholder": "请描述正在服用的药物"
