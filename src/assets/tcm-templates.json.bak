      "tcmDiagnosis": {
        "possiblePatterns": [
          {"pattern": "外邪犯胃", "keySymptoms": ["突然呕吐", "发热恶寒", "头痛", "苔白或黄"]},
          {"pattern": "饮食停滞", "keySymptoms": ["呕吐酸腐", "脘腹胀满", "嗳气", "不思饮食"]},
          {"pattern": "痰饮内停", "keySymptoms": ["呕吐清水痰涎", "头晕", "心悸", "苔白滑"]},
          {"pattern": "肝气犯胃", "keySymptoms": ["呕吐酸水", "胁肋胀痛", "情志诱发", "嗳气"]},
          {"pattern": "脾胃虚寒", "keySymptoms": ["呕吐清水", "喜温喜按", "纳差", "便溏", "舌淡"]},
          {"pattern": "胃阴不足", "keySymptoms": ["干呕", "口干", "纳少", "舌红少津"]}
        ]
      }
    },
