{
  "version": "1.0.0",
  "description": "中医症状问诊模板 - 基于五场专家研讨会设计",
  "lastUpdated": "2026-02-04",
  "fieldTypes": {
    "degree_slider": {
      "description": "程度滑块（轻/中/重）"
    },
    "body_location": {
      "description": "身体部位选择器"
    },
    "tongue_capture": {
      "description": "舌象拍照采集"
    },
    "time_picker_24": {
      "description": "十二时辰选择器"
    },
    "symptom_nature": {
      "description": "症状性质多选（中医特色）"
    },
    "preference_pair": {
      "description": "喜恶配对选择"
    }
  },
  "symptoms": [
    {
      "key": "tcm_headache",
      "name": "头痛",
      "priority": "P0",
      "tcmCategory": "痛证",
      "relatedMeridians": ["太阳经", "阳明经", "少阳经", "厥阴经"],
      "relatedOrgans": ["肝", "肾", "脾"],
      "config": {
        "sections": [
          {
            "title": "疼痛部位",
            "description": "头痛部位与经络归属密切相关",
            "fields": [
              {
                "key": "painLocation",
                "label": "头痛部位",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "forehead", "label": "前额部", "meridian": "阳明经"},
                    {"value": "temporal", "label": "两侧太阳穴", "meridian": "少阳经"},
                    {"value": "occipital", "label": "后头部", "meridian": "太阳经"},
                    {"value": "vertex", "label": "巅顶部", "meridian": "厥阴经"},
                    {"value": "whole", "label": "全头痛", "meridian": "多经"},
                    {"value": "uncertain", "label": "部位不固定", "meridian": "风邪"}
                  ]
                }
              }
            ]
          },
          {
            "title": "疼痛性质",
            "fields": [
              {
                "key": "painNature",
                "label": "头痛感觉",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "distending", "label": "胀痛", "indication": "气滞、肝阳"},
                    {"value": "stabbing", "label": "刺痛", "indication": "血瘀"},
                    {"value": "dull", "label": "隐痛", "indication": "虚证"},
                    {"value": "heavy", "label": "重痛如裹", "indication": "湿邪"},
                    {"value": "pulling", "label": "掣痛连项", "indication": "太阳经"},
                    {"value": "empty", "label": "空痛", "indication": "肾虚精亏"},
                    {"value": "throbbing", "label": "跳痛", "indication": "肝阳上亢"}
                  ]
                }
              },
              {
                "key": "painDegree",
                "label": "疼痛程度",
                "type": "degree_slider",
                "props": {
                  "min": 1,
                  "max": 10,
                  "labels": ["轻微", "中等", "剧烈"]
                }
              }
            ]
          },
          {
            "title": "时间特点",
            "fields": [
              {
                "key": "onsetTime",
                "label": "发病时间",
                "type": "input_radio",
                "props": {
                  "radioOptions": ["小时", "天", "周", "月", "年"]
                }
              },
              {
                "key": "timePattern",
                "label": "发作规律",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "morning", "label": "晨起加重", "indication": "阳虚、痰湿"},
                    {"value": "afternoon", "label": "午后加重", "indication": "阴虚、血虚"},
                    {"value": "night", "label": "夜间加重", "indication": "血瘀、阴虚"},
                    {"value": "fixed", "label": "定时发作", "indication": "瘀血"},
                    {"value": "continuous", "label": "持续不解", "indication": "实证"},
                    {"value": "intermittent", "label": "时作时止", "indication": "虚证、风邪"}
                  ]
                }
              },
              {
                "key": "weatherRelation",
                "label": "与天气关系",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "wind", "label": "刮风时加重", "indication": "风邪"},
                    {"value": "cold", "label": "遇冷加重", "indication": "寒邪"},
                    {"value": "heat", "label": "遇热加重", "indication": "热证"},
                    {"value": "rain", "label": "阴雨天加重", "indication": "湿邪"},
                    {"value": "none", "label": "与天气无关"}
                  ]
                }
              }
            ]
          },
          {
            "title": "诱发与缓解因素",
            "fields": [
              {
                "key": "triggers",
                "label": "诱发因素",
                "type": "checkbox",
                "props": {
                  "options": ["情绪激动", "劳累过度", "睡眠不足", "受凉受风", "饮食不节", "月经前后", "无明显诱因"]
                }
              },
              {
                "key": "reliefFactors",
                "label": "缓解因素",
                "type": "preference_pair",
                "props": {
                  "pairs": [
                    ["按压后减轻", "按压后加重"],
                    ["温敷后减轻", "冷敷后减轻"],
                    ["休息后减轻", "活动后减轻"],
                    ["进食后减轻", "进食后加重"]
                  ]
                }
              }
            ]
          },
          {
            "title": "伴随症状",
            "fields": [
              {
                "key": "accompaniedSymptoms",
                "label": "伴随症状",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "nausea", "label": "恶心欲吐", "indication": "痰饮、肝阳"},
                    {"value": "dizziness", "label": "头晕目眩", "indication": "肝阳、血虚"},
                    {"value": "chills", "label": "恶寒发热", "indication": "外感"},
                    {"value": "tinnitus", "label": "耳鸣", "indication": "肝肾"},
                    {"value": "irritability", "label": "烦躁易怒", "indication": "肝火"},
                    {"value": "fatigue", "label": "神疲乏力", "indication": "气虚"},
                    {"value": "insomnia", "label": "失眠多梦", "indication": "心肝"},
                    {"value": "blurred_vision", "label": "视物模糊", "indication": "肝血不足"}
                  ]
                }
              }
            ]
          }
        ]
      },
      "tcmDiagnosis": {
        "possiblePatterns": [
          {"pattern": "肝阳上亢", "keySymptoms": ["胀痛", "跳痛", "两侧", "烦躁"]},
          {"pattern": "肝肾阴虚", "keySymptoms": ["空痛", "隐痛", "午后重", "耳鸣"]},
          {"pattern": "气血两虚", "keySymptoms": ["隐痛", "乏力", "面色萎黄"]},
          {"pattern": "痰湿中阻", "keySymptoms": ["重痛如裹", "阴雨加重", "恶心"]},
          {"pattern": "瘀血阻络", "keySymptoms": ["刺痛", "固定不移", "夜间重"]},
          {"pattern": "风寒袭表", "keySymptoms": ["后头痛", "恶寒", "遇冷重"]},
          {"pattern": "风热上扰", "keySymptoms": ["胀痛", "发热", "口渴"]}
        ]
      }
    },
    {
      "key": "tcm_insomnia",
      "name": "失眠",
      "priority": "P0",
      "tcmCategory": "神志病",
      "relatedOrgans": ["心", "肝", "脾", "肾"],
      "config": {
        "sections": [
          {
            "title": "失眠类型",
            "fields": [
              {
                "key": "insomniaType",
                "label": "失眠表现",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "difficulty_falling", "label": "入睡困难", "indication": "心肝火旺、血虚"},
                    {"value": "easy_waking", "label": "易醒", "indication": "心脾两虚、心胆气虚"},
                    {"value": "early_waking", "label": "早醒", "indication": "心肾不交、阴虚"},
                    {"value": "dreamful", "label": "多梦", "indication": "心火旺、痰热"},
                    {"value": "nightmare", "label": "噩梦纷纭", "indication": "心胆气虚、痰火"},
                    {"value": "unable_to_sleep", "label": "彻夜不寐", "indication": "重证"}
                  ]
                }
              },
              {
                "key": "sleepDuration",
                "label": "每晚睡眠时间",
                "type": "number",
                "props": {
                  "unit": "小时",
                  "min": 0,
                  "max": 12
                }
              },
              {
                "key": "duration",
                "label": "失眠病程",
                "type": "input_radio",
                "props": {
                  "radioOptions": ["天", "周", "月", "年"]
                }
              }
            ]
          },
          {
            "title": "情志因素",
            "description": "七情与失眠密切相关",
            "fields": [
              {
                "key": "emotionalFactors",
                "label": "情志状态",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "anxiety", "label": "心烦焦虑", "indication": "心火、肝郁"},
                    {"value": "overthinking", "label": "思虑过度", "indication": "心脾两虚"},
                    {"value": "fear", "label": "心悸易惊", "indication": "心胆气虚"},
                    {"value": "depression", "label": "情绪低落", "indication": "肝郁"},
                    {"value": "irritability", "label": "急躁易怒", "indication": "肝火"},
                    {"value": "none", "label": "情绪平稳"}
                  ]
                }
              },
              {
                "key": "stressLevel",
                "label": "近期压力",
                "type": "degree_slider",
                "props": {
                  "min": 1,
                  "max": 10,
                  "labels": ["无压力", "压力适中", "压力很大"]
                }
              }
            ]
          },
          {
            "title": "伴随症状",
            "fields": [
              {
                "key": "accompaniedSymptoms",
                "label": "伴随不适",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "palpitation", "label": "心悸", "indication": "心血虚"},
                    {"value": "forgetfulness", "label": "健忘", "indication": "心脾两虚"},
                    {"value": "dizziness", "label": "头晕", "indication": "血虚、肝阳"},
                    {"value": "tinnitus", "label": "耳鸣", "indication": "肾虚"},
                    {"value": "night_sweat", "label": "盗汗", "indication": "阴虚"},
                    {"value": "dry_mouth", "label": "口干", "indication": "阴虚"},
                    {"value": "bitter_mouth", "label": "口苦", "indication": "肝火"},
                    {"value": "fatigue", "label": "神疲乏力", "indication": "气虚"},
                    {"value": "poor_appetite", "label": "纳差", "indication": "脾虚"},
                    {"value": "chest_tightness", "label": "胸闷", "indication": "痰湿"}
                  ]
                }
              }
            ]
          },
          {
            "title": "饮食习惯",
            "fields": [
              {
                "key": "dietaryFactors",
                "label": "饮食情况",
                "type": "checkbox",
                "props": {
                  "options": ["晚餐过饱", "睡前饮茶咖啡", "饮酒", "嗜食辛辣", "嗜食肥甘", "饮食规律", "食欲正常"]
                }
              }
            ]
          },
          {
            "title": "舌象脉象",
            "fields": [
              {
                "key": "tongueBody",
                "label": "舌质",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "pale", "label": "淡白", "indication": "气血虚"},
                    {"value": "red", "label": "红", "indication": "热证、阴虚"},
                    {"value": "crimson", "label": "绛红", "indication": "热入营血"},
                    {"value": "purple", "label": "紫暗", "indication": "血瘀"},
                    {"value": "normal", "label": "淡红（正常）"}
                  ]
                }
              },
              {
                "key": "tongueCoating",
                "label": "舌苔",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "thin_white", "label": "薄白", "indication": "正常或表证"},
                    {"value": "thin_yellow", "label": "薄黄", "indication": "热证"},
                    {"value": "thick_greasy", "label": "厚腻", "indication": "痰湿"},
                    {"value": "yellow_greasy", "label": "黄腻", "indication": "湿热"},
                    {"value": "little_none", "label": "少苔或无苔", "indication": "阴虚"}
                  ]
                }
              }
            ]
          }
        ]
      },
      "tcmDiagnosis": {
        "possiblePatterns": [
          {"pattern": "心脾两虚", "keySymptoms": ["易醒", "多梦", "心悸", "健忘", "乏力", "舌淡"]},
          {"pattern": "心肾不交", "keySymptoms": ["入睡难", "早醒", "心烦", "盗汗", "耳鸣", "舌红少苔"]},
          {"pattern": "肝郁化火", "keySymptoms": ["入睡难", "急躁", "口苦", "头痛", "舌红苔黄"]},
          {"pattern": "痰热扰心", "keySymptoms": ["多梦", "噩梦", "胸闷", "口苦", "舌红苔黄腻"]},
          {"pattern": "心胆气虚", "keySymptoms": ["易惊醒", "心悸", "胆怯", "舌淡"]}
        ]
      }
    },
    {
      "key": "tcm_dizziness",
      "name": "眩晕",
      "priority": "P0",
      "tcmCategory": "眩晕",
      "relatedOrgans": ["肝", "脾", "肾"],
      "classicTheory": "诸风掉眩，皆属于肝；无虚不作眩，无痰不作眩",
      "config": {
        "sections": [
          {
            "title": "眩晕特点",
            "fields": [
              {
                "key": "dizzinessType",
                "label": "眩晕感觉",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "spinning", "label": "天旋地转", "indication": "肝阳上亢"},
                    {"value": "floating", "label": "头重脚轻", "indication": "痰湿、气虚"},
                    {"value": "foggy", "label": "昏沉如蒙", "indication": "痰湿"},
                    {"value": "blurred", "label": "眼花眼黑", "indication": "血虚、肾虚"},
                    {"value": "unsteady", "label": "站立不稳", "indication": "肝肾亏虚"}
                  ]
                }
              },
              {
                "key": "onset",
                "label": "发作特点",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "sudden", "label": "突然发作", "indication": "实证、肝阳"},
                    {"value": "gradual", "label": "缓慢起病", "indication": "虚证"},
                    {"value": "recurrent", "label": "反复发作", "indication": "本虚标实"}
                  ]
                }
              }
            ]
          },
          {
            "title": "诱发因素",
            "fields": [
              {
                "key": "triggers",
                "label": "诱发因素",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "position", "label": "体位改变时", "indication": "气血虚"},
                    {"value": "fatigue", "label": "劳累后", "indication": "气虚"},
                    {"value": "emotion", "label": "情绪激动后", "indication": "肝阳"},
                    {"value": "diet", "label": "饮食后", "indication": "痰湿"},
                    {"value": "menstruation", "label": "月经期间", "indication": "血虚"},
                    {"value": "none", "label": "无明显诱因"}
                  ]
                }
              }
            ]
          },
          {
            "title": "伴随症状",
            "fields": [
              {
                "key": "accompaniedSymptoms",
                "label": "伴随症状",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "headache", "label": "头痛", "indication": "肝阳"},
                    {"value": "tinnitus", "label": "耳鸣", "indication": "肝肾"},
                    {"value": "nausea", "label": "恶心欲吐", "indication": "痰饮"},
                    {"value": "palpitation", "label": "心悸", "indication": "心血虚"},
                    {"value": "fatigue", "label": "神疲乏力", "indication": "气虚"},
                    {"value": "lassitude", "label": "腰膝酸软", "indication": "肾虚"},
                    {"value": "insomnia", "label": "失眠多梦", "indication": "心肝"},
                    {"value": "numbness", "label": "肢体麻木", "indication": "风痰、血虚"}
                  ]
                }
              }
            ]
          },
          {
            "title": "饮食二便",
            "fields": [
              {
                "key": "appetite",
                "label": "食欲",
                "type": "radio",
                "props": {
                  "options": ["正常", "食欲减退", "食后腹胀", "恶心厌食"]
                }
              },
              {
                "key": "stool",
                "label": "大便",
                "type": "radio",
                "props": {
                  "options": ["正常", "便溏", "便秘", "时干时稀"]
                }
              }
            ]
          }
        ]
      },
      "tcmDiagnosis": {
        "possiblePatterns": [
          {"pattern": "肝阳上亢", "keySymptoms": ["天旋地转", "头痛", "急躁", "面红", "舌红"]},
          {"pattern": "气血亏虚", "keySymptoms": ["头晕眼花", "面色萎黄", "乏力", "心悸", "舌淡"]},
          {"pattern": "痰湿中阻", "keySymptoms": ["头重如蒙", "恶心", "胸闷", "纳呆", "苔腻"]},
          {"pattern": "肾精不足", "keySymptoms": ["头晕", "耳鸣", "腰膝酸软", "健忘", "舌淡"]}
        ]
      }
    },
    {
      "key": "tcm_cough",
      "name": "咳嗽",
      "priority": "P0",
      "tcmCategory": "肺系病证",
      "relatedOrgans": ["肺", "脾", "肾"],
      "classicTheory": "五脏六腑皆令人咳，非独肺也",
      "config": {
        "sections": [
          {
            "title": "咳嗽特点",
            "fields": [
              {
                "key": "coughSound",
                "label": "咳嗽声音",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "loud", "label": "咳声洪亮有力", "indication": "实证"},
                    {"value": "weak", "label": "咳声低弱无力", "indication": "虚证"},
                    {"value": "dry", "label": "干咳少痰", "indication": "燥邪、阴虚"},
                    {"value": "moist", "label": "痰多易咳", "indication": "痰湿"},
                    {"value": "barking", "label": "咳如犬吠", "indication": "燥痰"}
                  ]
                }
              },
              {
                "key": "coughTiming",
                "label": "咳嗽时间",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "morning", "label": "晨起咳甚", "indication": "痰湿"},
                    {"value": "night", "label": "夜间咳甚", "indication": "阴虚"},
                    {"value": "after_meal", "label": "食后咳嗽", "indication": "食积"},
                    {"value": "anytime", "label": "整日咳嗽", "indication": "实证"}
