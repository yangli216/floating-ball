  "commonModules": [
    {
      "key": "tcm_ten_questions",
      "name": "十问模块",
      "description": "中医传统十问框架，适用于所有症状的通用问诊",
      "reference": "一问寒热二问汗，三问头身四问便，五问饮食六胸腹，七聋八渴俱当辨，九问旧病十问因，再兼服药参机变",
      "config": {
        "sections": [
          {
            "title": "一问寒热",
            "fields": [
              {
                "key": "coldHeat",
                "label": "平素寒热",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "fear_cold", "label": "怕冷", "indication": "阳虚"},
                    {"value": "fear_heat", "label": "怕热", "indication": "阴虚"},
                    {"value": "both", "label": "既怕冷又怕热", "indication": "阴阳两虚"},
                    {"value": "normal", "label": "寒热适中"}
                  ]
                }
              },
              {
                "key": "limbTemperature",
                "label": "手足温度",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "cold", "label": "手足冰凉", "indication": "阳虚"},
                    {"value": "warm", "label": "手足心热", "indication": "阴虚"},
                    {"value": "normal", "label": "温度正常"}
                  ]
                }
              }
            ]
          },
          {
            "title": "二问汗",
            "fields": [
              {
                "key": "sweating",
                "label": "出汗情况",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "spontaneous", "label": "自汗（白天易出汗）", "indication": "气虚"},
                    {"value": "night", "label": "盗汗（睡中出汗）", "indication": "阴虚"},
                    {"value": "none", "label": "不易出汗"},
                    {"value": "normal", "label": "出汗正常"}
                  ]
                }
              }
            ]
          },
          {
            "title": "三问头身",
            "fields": [
              {
                "key": "headBody",
                "label": "头身感觉",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "headache", "label": "头痛"},
                    {"value": "dizziness", "label": "头晕"},
                    {"value": "heavy_head", "label": "头重如裹", "indication": "湿邪"},
                    {"value": "body_heavy", "label": "身体困重", "indication": "湿邪"},
                    {"value": "fatigue", "label": "乏力"},
                    {"value": "body_pain", "label": "身体疼痛"},
                    {"value": "none", "label": "无不适"}
                  ]
                }
              }
            ]
          },
          {
            "title": "四问便",
            "fields": [
              {
                "key": "stool",
                "label": "大便",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "normal", "label": "正常"},
                    {"value": "loose", "label": "便溏", "indication": "脾虚"},
                    {"value": "diarrhea", "label": "腹泻"},
                    {"value": "constipation", "label": "便秘"},
                    {"value": "dry_hard", "label": "干结", "indication": "阴虚/热"}
                  ]
                }
              },
              {
                "key": "urine",
                "label": "小便",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "normal", "label": "正常"},
                    {"value": "frequent", "label": "尿频", "indication": "肾虚"},
                    {"value": "scanty_yellow", "label": "短赤", "indication": "湿热"},
                    {"value": "clear_profuse", "label": "清长", "indication": "阳虚"},
                    {"value": "nocturia", "label": "夜尿多", "indication": "肾阳虚"}
                  ]
                }
              }
            ]
          },
          {
            "title": "五问饮食",
            "fields": [
              {
                "key": "appetite",
                "label": "食欲",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "normal", "label": "正常"},
                    {"value": "poor", "label": "纳差", "indication": "脾虚"},
                    {"value": "excessive", "label": "多食易饥", "indication": "胃热"},
                    {"value": "no_hunger", "label": "不知饥饿", "indication": "脾虚"}
                  ]
                }
              },
              {
                "key": "taste",
                "label": "口中感觉",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "normal", "label": "正常"},
                    {"value": "bitter", "label": "口苦", "indication": "肝胆热"},
                    {"value": "sweet", "label": "口甜", "indication": "脾虚湿热"},
                    {"value": "sour", "label": "口酸", "indication": "肝热"},
                    {"value": "bland", "label": "口淡", "indication": "脾虚"}
                  ]
                }
              }
            ]
          },
          {
            "title": "六问胸腹",
            "fields": [
              {
                "key": "chestAbdomen",
                "label": "胸腹感觉",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "normal", "label": "正常"},
                    {"value": "chest_tightness", "label": "胸闷", "indication": "气滞/痰阻"},
                    {"value": "flank_pain", "label": "胁痛", "indication": "肝郁"},
                    {"value": "epigastric", "label": "胃脘不适"},
                    {"value": "bloating", "label": "腹胀", "indication": "气滞"}
                  ]
                }
              }
            ]
          },
          {
            "title": "七聋八渴",
            "fields": [
              {
                "key": "hearing",
                "label": "听力",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "normal", "label": "正常"},
                    {"value": "tinnitus", "label": "耳鸣", "indication": "肝肾"},
                    {"value": "hearing_loss", "label": "听力下降"}
                  ]
                }
              },
              {
                "key": "thirst",
                "label": "口渴",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "normal", "label": "正常"},
                    {"value": "thirsty_cold", "label": "渴喜冷饮", "indication": "热证"},
                    {"value": "thirsty_warm", "label": "渴喜热饮", "indication": "寒证"},
                    {"value": "dry_no_desire", "label": "口干不欲饮", "indication": "阴虚/湿热"},
                    {"value": "no_thirst", "label": "不渴", "indication": "寒证"}
                  ]
                }
              }
            ]
          },
          {
            "title": "九问旧病十问因",
            "fields": [
              {
                "key": "pastHistory",
                "label": "既往病史",
