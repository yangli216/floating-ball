          {"pattern": "痛痹（寒邪偏盛）", "keySymptoms": ["剧痛", "固定", "遇寒加重", "得温减", "苔白"]},
          {"pattern": "着痹（湿邪偏盛）", "keySymptoms": ["重着酸痛", "固定", "阴雨加重", "身困", "苔腻"]},
          {"pattern": "热痹（热邪偏盛）", "keySymptoms": ["红肿热痛", "发热", "口渴", "苔黄"]},
          {"pattern": "痰瘀痹阻", "keySymptoms": ["关节肿大", "僵硬", "刺痛", "舌紫暗"]},
          {"pattern": "肝肾亏虚", "keySymptoms": ["酸痛绵绵", "腰膝酸软", "久痹", "舌淡"]}
        ]
      }
