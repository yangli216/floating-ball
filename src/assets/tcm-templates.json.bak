                "props": {
                  "options": [
                    {"value": "thin", "label": "稀薄", "indication": "寒证"},
                    {"value": "thick", "label": "黏稠", "indication": "热证"},
                    {"value": "lumpy", "label": "成块难咯", "indication": "燥痰"},
                    {"value": "foamy", "label": "泡沫状", "indication": "风寒"}
                  ]
                }
              }
            ]
          },
          {
            "title": "寒热辨证",
            "fields": [
              {
                "key": "coldHeat",
                "label": "寒热感觉",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "chills", "label": "恶寒", "indication": "表寒"},
                    {"value": "fever", "label": "发热", "indication": "表证"},
                    {"value": "sore_throat", "label": "咽痛", "indication": "风热"},
                    {"value": "itchy_throat", "label": "咽痒", "indication": "风寒"},
                    {"value": "thirst", "label": "口渴欲饮", "indication": "热证"},
                    {"value": "no_thirst", "label": "口不渴", "indication": "寒证"}
                  ]
                }
              }
            ]
