          },
          {
            "title": "睡眠情志",
            "fields": [
              {
                "key": "sleep",
                "label": "睡眠",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "normal", "label": "正常"},
                    {"value": "difficulty", "label": "入睡困难"},
                    {"value": "easy_wake", "label": "易醒"},
                    {"value": "dreamful", "label": "多梦"},
                    {"value": "excessive", "label": "嗜睡", "indication": "痰湿/阳虚"}
                  ]
                }
              },
              {
                "key": "emotion",
                "label": "情志",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "normal", "label": "情绪平稳"},
                    {"value": "irritable", "label": "急躁易怒", "indication": "肝火"},
                    {"value": "depressed", "label": "抑郁", "indication": "肝郁"},
                    {"value": "anxious", "label": "焦虑"},
                    {"value": "fearful", "label": "易惊恐", "indication": "心胆虚"}
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "key": "tcm_tongue_pulse",
      "name": "舌脉采集模块",
      "description": "舌象和脉象的结构化采集",
      "config": {
        "sections": [
          {
            "title": "舌象",
            "fields": [
              {
                "key": "tongueImage",
                "label": "舌象照片",
                "type": "tongue_capture",
                "props": {
                  "instruction": "请张口伸舌，在自然光线下拍照"
                }
              },
              {
                "key": "tongueBody",
                "label": "舌质",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "pale", "label": "淡白", "indication": "气血虚/阳虚"},
                    {"value": "light_red", "label": "淡红", "indication": "正常"},
                    {"value": "red", "label": "红", "indication": "热证"},
                    {"value": "crimson", "label": "绛红", "indication": "热入营血"},
                    {"value": "purple", "label": "紫暗", "indication": "血瘀"},
                    {"value": "blue_purple", "label": "青紫", "indication": "寒凝血瘀"}
                  ]
                }
              },
              {
                "key": "tongueShape",
                "label": "舌形",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "normal", "label": "正常"},
                    {"value": "fat", "label": "胖大", "indication": "阳虚/痰湿"},
                    {"value": "thin", "label": "瘦薄", "indication": "阴虚/血虚"},
                    {"value": "teeth_marks", "label": "齿痕", "indication": "脾虚"},
                    {"value": "cracked", "label": "裂纹", "indication": "阴虚"},
                    {"value": "prickly", "label": "芒刺", "indication": "热盛"},
                    {"value": "deviated", "label": "歪斜", "indication": "中风"}
                  ]
                }
              },
              {
                "key": "tongueCoating",
                "label": "舌苔颜色",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "thin_white", "label": "薄白", "indication": "正常/表证"},
                    {"value": "white", "label": "白", "indication": "寒证"},
                    {"value": "yellow", "label": "黄", "indication": "热证"},
                    {"value": "gray_black", "label": "灰黑", "indication": "热极/寒极"}
                  ]
                }
              },
              {
                "key": "coatingTexture",
                "label": "苔质",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "thin", "label": "薄苔", "indication": "正常/表证"},
                    {"value": "thick", "label": "厚苔", "indication": "痰湿/食积"},
                    {"value": "greasy", "label": "腻苔", "indication": "痰湿"},
                    {"value": "dry", "label": "燥苔", "indication": "津伤"},
                    {"value": "peeled", "label": "剥苔", "indication": "胃阴虚"},
                    {"value": "none", "label": "无苔", "indication": "胃阴虚"}
                  ]
                }
              }
            ]
          },
          {
            "title": "脉象",
            "description": "如已由医师诊脉，请选择脉象特点",
            "fields": [
              {
                "key": "pulseRate",
                "label": "脉率",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "slow", "label": "迟脉（<60次/分）", "indication": "寒证"},
                    {"value": "normal", "label": "正常（60-90次/分）"},
                    {"value": "fast", "label": "数脉（>90次/分）", "indication": "热证"}
                  ]
                }
              },
              {
                "key": "pulseDepth",
                "label": "脉位",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "floating", "label": "浮脉", "indication": "表证"},
                    {"value": "normal", "label": "中"},
                    {"value": "deep", "label": "沉脉", "indication": "里证"}
                  ]
                }
              },
              {
                "key": "pulseStrength",
                "label": "脉力",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "strong", "label": "有力", "indication": "实证"},
                    {"value": "normal", "label": "正常"},
                    {"value": "weak", "label": "无力", "indication": "虚证"}
                  ]
                }
              },
              {
                "key": "pulseShape",
                "label": "脉形",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "wiry", "label": "弦脉", "indication": "肝胆病/痛证"},
                    {"value": "slippery", "label": "滑脉", "indication": "痰湿/食积"},
                    {"value": "choppy", "label": "涩脉", "indication": "血瘀/精血亏"},
                    {"value": "thin", "label": "细脉", "indication": "血虚/阴虚"},
                    {"value": "big", "label": "洪脉", "indication": "热盛"},
                    {"value": "knotted", "label": "结代脉", "indication": "心病"}
                  ]
                }
              },
              {
                "key": "pulseNote",
                "label": "脉象补充",
                "type": "input",
                "props": {
                  "placeholder": "医师可补充其他脉象特点"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "key": "tcm_constitution",
      "name": "体质辨识模块",
      "description": "九种体质快速筛查",
      "reference": "中华中医药学会《中医体质分类与判定》",
      "config": {
        "sections": [
          {
            "title": "体质快速筛查",
            "description": "请根据您的日常状态选择最符合的描述",
            "fields": [
              {
                "key": "constitutionType",
                "label": "体质倾向",
                "type": "checkbox",
                "props": {
                  "options": [
                    {"value": "balanced", "label": "平和质", "description": "精力充沛，睡眠良好，性格开朗", "indication": "健康状态"},
                    {"value": "qi_deficiency", "label": "气虚质", "description": "容易疲乏，气短懒言，易出汗", "indication": "需补气"},
                    {"value": "yang_deficiency", "label": "阳虚质", "description": "怕冷，手脚冰凉，喜热饮食", "indication": "需温阳"},
                    {"value": "yin_deficiency", "label": "阴虚质", "description": "怕热，手足心热，口干咽干", "indication": "需滋阴"},
                    {"value": "phlegm_dampness", "label": "痰湿质", "description": "体形肥胖，腹部肥满，痰多", "indication": "需化痰祛湿"},
                    {"value": "damp_heat", "label": "湿热质", "description": "面部油腻，易生痤疮，口苦口干", "indication": "需清热利湿"},
                    {"value": "blood_stasis", "label": "血瘀质", "description": "面色晦暗，易有瘀斑，唇色暗", "indication": "需活血化瘀"},
                    {"value": "qi_stagnation", "label": "气郁质", "description": "情绪低落，多愁善感，胸闷叹息", "indication": "需疏肝理气"},
                    {"value": "special", "label": "特禀质", "description": "容易过敏，有家族过敏史", "indication": "需益气固表"}
                  ],
                  "maxSelect": 3
                }
              }
            ]
          },
          {
            "title": "体质相关症状",
            "fields": [
              {
                "key": "energyLevel",
                "label": "精力状态",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "vigorous", "label": "精力充沛"},
                    {"value": "moderate", "label": "一般"},
                    {"value": "low", "label": "容易疲劳", "indication": "气虚"}
                  ]
                }
              },
              {
                "key": "coldHeatPreference",
                "label": "寒热偏好",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "cold", "label": "怕冷，喜热", "indication": "阳虚"},
                    {"value": "heat", "label": "怕热，喜凉", "indication": "阴虚/湿热"},
                    {"value": "balanced", "label": "不怕冷也不怕热"}
                  ]
                }
              },
              {
                "key": "bodyShape",
                "label": "体形特点",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "thin", "label": "偏瘦", "indication": "阴虚/血虚"},
                    {"value": "normal", "label": "适中"},
                    {"value": "overweight", "label": "偏胖", "indication": "痰湿"}
                  ]
                }
              },
              {
                "key": "emotionalState",
                "label": "情绪特点",
                "type": "radio",
                "props": {
                  "options": [
                    {"value": "cheerful", "label": "性格开朗"},
                    {"value": "moderate", "label": "情绪稳定"},
                    {"value": "depressed", "label": "容易低落", "indication": "气郁"},
                    {"value": "irritable", "label": "容易烦躁", "indication": "阴虚/肝火"}
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
