    {
      "key": "tcm_diarrhea",
      "name": "泄泻",
      "priority": "P1",
      "tcmCategory": "脾胃病证",
      "relatedOrgans": ["脾", "胃", "肾", "肝"],
      "classicTheory": "泄泻之本，无不由于脾胃",
      "config": {
        "sections": [
          {
            "title": "病程特点",
            "fields": [
              {
                "key": "courseType",
                "label": "发病特点",
