                "props": {
                  "options": [
                    {"value": "cold_food", "label": "进食生冷", "indication": "寒湿"},
                    {"value": "greasy_food", "label": "进食油腻", "indication": "湿热"},
                    {"value": "unclean_food", "label": "饮食不洁", "indication": "湿热"},
