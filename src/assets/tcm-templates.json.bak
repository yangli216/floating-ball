          {"pattern": "心血虚", "keySymptoms": ["心悸", "失眠", "多梦", "头晕", "面色萎黄", "舌淡"]},
          {"pattern": "心阴虚", "keySymptoms": ["心悸", "心烦", "失眠", "盗汗", "五心烦热", "舌红少苔"]},
          {"pattern": "心阳虚", "keySymptoms": ["心悸", "胸闷", "畏寒", "肢冷", "水肿", "舌淡胖"]},
          {"pattern": "心胆气虚", "keySymptoms": ["心悸", "善惊易恐", "坐卧不安", "舌淡"]},
          {"pattern": "心脾两虚", "keySymptoms": ["心悸", "健忘", "失眠", "纳差", "乏力", "舌淡"]},
          {"pattern": "心血瘀阻", "keySymptoms": ["心悸", "胸闷刺痛", "面色晦暗", "舌紫暗"]},
          {"pattern": "痰火扰心", "keySymptoms": ["心悸", "心烦", "失眠", "痰多", "口苦", "苔黄腻"]},
          {"pattern": "水饮凌心", "keySymptoms": ["心悸", "胸闷", "气短", "水肿", "不能平卧", "舌淡胖"]}
        ]
      }
    },
    {
      "key": "tcm_vomiting",
