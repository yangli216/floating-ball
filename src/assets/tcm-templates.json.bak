                    {"value": "bloating", "label": "脘腹胀满", "indication": "食积/气滞"},
                    {"value": "belching", "label": "嗳气", "indication": "食积/气滞"},
                    {"value": "acid_reflux", "label": "泛酸", "indication": "肝胃不和"},
                    {"value": "diarrhea", "label": "腹泻", "indication": "脾虚/寒湿"}
                  ]
                }
              }
            ]
          }
