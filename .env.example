# 通义千问 (Qwen) 配置示例
# 本地开发时复制此文件为 .env 并填入真实值
# CI/Release 构建从 GitHub Secrets 自动注入，无需 .env 文件

# 兼容 OpenAI 协议的 Base URL
VITE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称 (qwen-plus, qwen-turbo, qwen-max 等)
VITE_LLM_MODEL=qwen3.5-flash

# 你的阿里云 DashScope API Key（从 GitHub Secrets 注入或本地填写）
VITE_OPENAI_API_KEY=your-api-key-here

# 阿里云 DashScope API Key
VITE_DASHSCOPE_API_KEY=your-dashscope-key-here

# 启用测试模式
VITE_SPEECH_TEST_MODE=false
